<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0f172a">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="NHDD"
            app:subtitle="No-Hook DEX Dumper"
            app:titleTextColor="#38bdf8"
            app:subtitleTextColor="#94a3b8" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STATUS"
                            android:textColor="#94a3b8"
                            android:textSize="12sp"
                            android:letterSpacing="1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="Module" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_module" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="SO File" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_so" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="Scanner" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_scanner" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="Mode" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_mode" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="DEX Files" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_dex_count" style="@style/ValueStyle" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Config Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CONFIG"
                            android:textColor="#94a3b8"
                            android:textSize="12sp"
                            android:letterSpacing="1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="enable" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_enable" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="dump_dex" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_dump_dex" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="art_hook" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_art_hook" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="delay_ms" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_delay" style="@style/ValueStyle" />
                        </LinearLayout>
                        <LinearLayout style="@style/RowStyle">
                            <TextView android:text="dump_dir" style="@style/LabelStyle" />
                            <TextView android:id="@+id/tv_dump_dir" style="@style/ValueStyle" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Mode Switch Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MODE"
                            android:textColor="#94a3b8"
                            android:textSize="12sp"
                            android:letterSpacing="1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_nohook"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="NOHOOK"
                                app:backgroundTint="#16a34a"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_hook"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="HOOK"
                                app:backgroundTint="#ca8a04"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="8dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_enable"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="Enable"
                                app:backgroundTint="#2563eb"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_disable"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="Disable"
                                app:backgroundTint="#dc2626"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Packages Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PACKAGES"
                            android:textColor="#94a3b8"
                            android:textSize="12sp"
                            android:letterSpacing="1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:id="@+id/pkg_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_package"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="com.example.app"
                                android:textColor="#e2e8f0"
                                android:textColorHint="#475569"
                                android:backgroundTint="#475569"
                                android:textSize="13sp"
                                android:padding="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_add_pkg"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Add"
                                app:backgroundTint="#2563eb"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Actions Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIONS"
                            android:textColor="#94a3b8"
                            android:textSize="12sp"
                            android:letterSpacing="1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_scan_pkg"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="Package (empty=first)"
                                android:textColor="#e2e8f0"
                                android:textColorHint="#475569"
                                android:backgroundTint="#475569"
                                android:textSize="13sp"
                                android:padding="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_scan"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Scan"
                                app:backgroundTint="#2563eb"
                                app:cornerRadius="8dp" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_dump"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Quick Dump (Restart + Scan)"
                            app:backgroundTint="#16a34a"
                            app:cornerRadius="8dp"
                            android:textAllCaps="false" />

                        <TextView
                            android:id="@+id/tv_output"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#0f172a"
                            android:padding="12dp"
                            android:layout_marginTop="8dp"
                            android:textColor="#4ade80"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:visibility="gone"
                            android:maxHeight="200dp"
                            android:scrollbars="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Dump Dir Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="#1e293b"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DUMP DIR"
                            android:textColor="#94a3b8"
                            android:textSize="12sp"
                            android:letterSpacing="1"
                            android:layout_marginBottom="8dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_dump_dir"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="/data/local/tmp/nhdd_dump"
                                android:textColor="#e2e8f0"
                                android:textColorHint="#475569"
                                android:backgroundTint="#475569"
                                android:textSize="13sp"
                                android:padding="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_set_dir"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Set"
                                app:backgroundTint="#475569"
                                app:cornerRadius="8dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NHDD v2.0 | APatch + ZygiskSU"
                    android:textColor="#475569"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
